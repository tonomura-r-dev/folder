{
  "name": "line-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "LINE施策統合シミュレーター",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:pane": "vite --open false",
    "sim": "node tools/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:engine": "node tools/check-engine.ts",
    "check": "npm run typecheck && npm run check:engine && npm run test",
    "export": "node tools/export.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
