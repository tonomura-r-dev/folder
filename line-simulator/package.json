{
  "name": "line-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "LINE施策統合シミュレーター",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sim": "node tools/run.ts",
