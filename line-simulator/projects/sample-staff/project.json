  "messages": [
    {
      "id": "msg_welcome",
      "bubbles": [{ "kind": "text", "text": "{{user.name}}、友だち追加ありがとうございます。\n{{brand.accountName}}です。\n\nあなたに合う求人だけをお届けするため、2つだけ質問させてください。" }]
    },
    {
      "id": "msg_welcome_applied",
      "bubbles": [{ "kind": "text", "text": "{{user.name}}、ご応募ありがとうございます。\n選考のご連絡は、このLINEでお送りします。\n\nほかにも合う求人があればお届けしますので、2つだけ教えてください。" }]
    },
    {
      "id": "msg_t_d1",
      "bubbles": [{ "kind": "text", "text": "【東京エリア】今週の新着求人です。\n\n・丸の内　一般事務　時給1,600円\n・新宿　データ入力　時給1,500円\n・品川　倉庫内軽作業　時給1,400円\n\n※架空の求人です" }]
    },
    {
      "id": "msg_t_office",
      "bubbles": [
        { "kind": "text", "text": "事務のお仕事をお探しの方へ。\n未経験から始められる東京の事務求人をまとめました。" },
        {
          "kind": "card",
          "title": "丸の内　一般事務（架空）",
          "body": "時給1,600円／週3日〜／残業ほぼなし",
          "buttons": [{ "id": "btn_t_office_apply", "label": "この求人に応募する", "action": { "kind": "openPage", "pageId": "page_form" } }]
        }
      ]
    },
    {
      "id": "msg_t_light",
      "bubbles": [
        { "kind": "text", "text": "軽作業のお仕事をお探しの方へ。\n東京で人気の軽作業求人です。" },
        {
          "kind": "card",
          "title": "品川　倉庫内軽作業（架空）",
          "body": "時給1,400円／日払いOK",
          "buttons": [{ "id": "btn_t_light_apply", "label": "この求人に応募する", "action": { "kind": "openPage", "pageId": "page_form" } }]
        }
      ]
    },
    {
      "id": "msg_t_d7",
      "bubbles": [
        {
          "kind": "buttons",
          "text": "ご案内した求人はいかがでしたか？\n気になる求人があれば、ここから応募できます。",
          "buttons": [
            { "id": "btn_t_apply", "label": "応募する", "action": { "kind": "openPage", "pageId": "page_form" } },
            { "id": "btn_t_later", "label": "今回は見送る", "action": { "kind": "none" } }
          ]
        }
      ]
    },
    { "id": "msg_t_later", "bubbles": [{ "kind": "text", "text": "承知しました。\n条件に合う求人が出たら、またお知らせします。" }] },
    {
      "id": "msg_o_d1",
      "bubbles": [{ "kind": "text", "text": "【大阪エリア】今週の新着求人です。\n\n・梅田　受付事務　時給1,350円\n・堺　ピッキング　時給1,250円\n・なんば　コールセンター　時給1,400円\n\n※架空の求人です" }]
    },
    { "id": "msg_o_d3", "bubbles": [{ "kind": "text", "text": "大阪エリアの、週2日から働ける求人をまとめました。\n家庭やほかの予定と両立したい方におすすめです。" }] },
    {
      "id": "msg_o_d7",
      "bubbles": [
        {
          "kind": "card",
          "title": "梅田　受付事務（架空）",
          "body": "時給1,350円／駅直結",
          "buttons": [{ "id": "btn_o_apply", "label": "この求人に応募する", "action": { "kind": "openPage", "pageId": "page_form" } }]
        }
      ]
    },
    {
      "id": "msg_c_remind",
      "bubbles": [
        {
          "kind": "buttons",
          "text": "{{user.name}}、希望エリアがまだ選ばれていません。\nエリアを選ぶと、そのエリアの新着求人だけをお届けします。",
          "buttons": [
            { "id": "btn_c_remind_tokyo", "label": "東京", "action": { "kind": "answer", "surveyId": "sv_hope", "questionId": "q_area", "choiceId": "c_tokyo" } },
            { "id": "btn_c_remind_osaka", "label": "大阪", "action": { "kind": "answer", "surveyId": "sv_hope", "questionId": "q_area", "choiceId": "c_osaka" } }
          ]
        }
      ]
    },
    {
      "id": "msg_c_ask",
      "bubbles": [
        {
          "kind": "buttons",
          "text": "希望エリアを教えていただくと、そのエリアの求人だけをお送りできます。",
          "buttons": [
            { "id": "btn_c_tokyo", "label": "東京", "action": { "kind": "answer", "surveyId": "sv_hope", "questionId": "q_area", "choiceId": "c_tokyo" } },
            { "id": "btn_c_osaka", "label": "大阪", "action": { "kind": "answer", "surveyId": "sv_hope", "questionId": "q_area", "choiceId": "c_osaka" } }
          ]
        }
      ]
    },
    { "id": "msg_c_general", "bubbles": [{ "kind": "text", "text": "今週の人気求人です。\n\n・丸の内　一般事務\n・梅田　受付事務\n\n気になる求人があれば、メニューの「応募する」からどうぞ。" }] },
    { "id": "msg_a_interview", "bubbles": [{ "kind": "text", "text": "ご応募いただいた求人について、担当者から面接日程のご連絡をします。\n当日の持ち物や服装は、このLINEでご案内します。" }] },
    {
      "id": "msg_a_reapply",
      "bubbles": [
        { "kind": "text", "text": "ご希望に近い求人が、ほかにも出ています。" },
        {
          "kind": "card",
          "title": "新宿　データ入力（架空）",
          "body": "時給1,500円／在宅併用あり",
          "buttons": [{ "id": "btn_a_reapply", "label": "この求人にも応募する", "action": { "kind": "openPage", "pageId": "page_form" } }]
        }
      ]
    },
    { "id": "msg_r_tokyo", "bubbles": [{ "kind": "text", "text": "東京エリアの求人は、こちらです。\n・丸の内　一般事務\n・新宿　データ入力\n・品川　倉庫内軽作業" }] },
    { "id": "msg_r_osaka", "bubbles": [{ "kind": "text", "text": "大阪エリアの求人は、こちらです。\n・梅田　受付事務\n・堺　ピッキング\n・なんば　コールセンター" }] },
    {
      "id": "msg_r_ask_area",
      "bubbles": [
        {
          "kind": "buttons",
          "text": "希望エリアがまだ登録されていません。どちらのエリアの求人をお探しですか？",
          "buttons": [
            { "id": "btn_r_tokyo", "label": "東京", "action": { "kind": "answer", "surveyId": "sv_hope", "questionId": "q_area", "choiceId": "c_tokyo" } },
            { "id": "btn_r_osaka", "label": "大阪", "action": { "kind": "answer", "surveyId": "sv_hope", "questionId": "q_area", "choiceId": "c_osaka" } }
          ]
        }
      ]
    },
    { "id": "msg_r_condition", "bubbles": [{ "kind": "text", "text": "いま登録されている希望条件です。\nエリア：{{answer.sv_hope.q_area}}\n職種：{{answer.sv_hope.q_job}}" }] },
    {
      "id": "msg_r_faq",
      "bubbles": [{ "kind": "text", "text": "よくあるご質問\n\nQ. 未経験でも応募できますか？\nA. はい。多くの求人が未経験から応募できます。\n\nQ. 応募したら必ず働く必要がありますか？\nA. いいえ。面談のうえでお決めいただけます。" }]
    },
    { "id": "msg_r_contact", "bubbles": [{ "kind": "text", "text": "お問い合わせありがとうございます。\n担当者から順にご返信します。" }] }
  ],
  "richMenus": [
    {
      "id": "rm_main",
      "label": "メインメニュー",
      "layout": { "cols": 3, "rows": 2 },
      "cells": [
        { "id": "cell_jobs", "label": "求人を探す", "area": { "col": 0, "row": 0 }, "action": { "kind": "sendText", "text": "求人" } },
        { "id": "cell_apply", "label": "応募する", "area": { "col": 1, "row": 0 }, "action": { "kind": "openPage", "pageId": "page_form" } },
        { "id": "cell_condition", "label": "希望条件", "area": { "col": 2, "row": 0 }, "action": { "kind": "sendText", "text": "希望条件" } },
        { "id": "cell_faq", "label": "よくある質問", "area": { "col": 0, "row": 1 }, "action": { "kind": "sendText", "text": "よくある質問" } },
        { "id": "cell_company", "label": "会社について", "area": { "col": 1, "row": 1 }, "action": { "kind": "openPage", "pageId": "page_lp" } },
        { "id": "cell_contact", "label": "お問い合わせ", "area": { "col": 2, "row": 1 }, "action": { "kind": "sendText", "text": "問い合わせ" } }
      ]
    }
  ],
  "autoReplies": [
    {
      "id": "ar_jobs",
      "priority": 10,
      "match": { "mode": "contains", "keywords": ["求人"] },
      "cases": [
        { "when": { "op": "hasTag", "tagId": "area_tokyo" }, "messageId": "msg_r_tokyo" },
        { "when": { "op": "hasTag", "tagId": "area_osaka" }, "messageId": "msg_r_osaka" }
      ],
      "fallbackMessageId": "msg_r_ask_area"
    },
    {
      "id": "ar_condition",
      "priority": 20,
      "match": { "mode": "exact", "keywords": ["希望条件"] },
      "cases": [{ "when": { "op": "answered", "surveyId": "sv_hope" }, "messageId": "msg_r_condition" }],
      "fallbackMessageId": "msg_r_ask_area"
    },
    { "id": "ar_faq", "priority": 30, "match": { "mode": "exact", "keywords": ["よくある質問"] }, "cases": [], "fallbackMessageId": "msg_r_faq" },
    { "id": "ar_contact", "priority": 40, "match": { "mode": "contains", "keywords": ["問い合わせ"] }, "cases": [], "fallbackMessageId": "msg_r_contact" }
  ],
  "surveys": [
    {
      "id": "sv_hope",
      "label": "希望条件アンケート",
      "questions": [
        {
          "id": "q_area",
          "text": "希望の勤務エリアを教えてください",
          "mode": "single",
          "choices": [
            { "id": "c_tokyo", "label": "東京", "addTags": ["area_tokyo", "area_selected"], "removeTags": ["area_osaka", "area_none"] },
            { "id": "c_osaka", "label": "大阪", "addTags": ["area_osaka", "area_selected"], "removeTags": ["area_tokyo", "area_none"] }
          ]
        },
        {
          "id": "q_job",
          "text": "希望の職種を教えてください",
          "mode": "single",
          "choices": [
            { "id": "c_office", "label": "事務", "addTags": ["job_office"], "removeTags": ["job_light"] },
            { "id": "c_light", "label": "軽作業", "addTags": ["job_light"], "removeTags": ["job_office"] }
          ]
        }
      ]
    }
  ],
  "webPages": [
    {
      "id": "page_lp",
      "kind": "lp",
      "title": "サンプルスタッフ（仮）求人情報",
      "url": "https://example.com/jobs",
      "blocks": [
        { "kind": "heading", "text": "未経験からはじめる、東京・大阪のお仕事" },
        { "kind": "text", "text": "事務・軽作業を中心に、週2日から働ける求人を掲載しています。（架空のサイトです）" },
        { "kind": "button", "label": "求人に応募する", "action": { "kind": "openPage", "pageId": "page_form" } }
      ],
      "exitPopup": {
        "title": "新着求人を、LINEで受け取りませんか？",
        "body": "希望エリアに合った求人だけを、LINEでお届けします。",
        "cta": { "label": "LINEで受け取る", "action": { "kind": "addFriend", "routeId": "route_exit_popup" } },
        "dismissLabel": "閉じる"
      }
    },
    {
      "id": "page_form",
      "kind": "form",
      "title": "応募フォーム",
      "url": "https://example.com/apply",
      "blocks": [{ "kind": "heading", "text": "応募フォーム" }],
      "form": {
        "fields": [
          { "id": "f_name", "label": "お名前", "type": "text" },
          { "id": "f_tel", "label": "電話番号", "type": "tel" },
          { "id": "f_area", "label": "希望エリア", "type": "select", "options": ["東京", "大阪"] }
        ],
        "onSubmit": { "cvId": "cv_apply", "nextPageId": "page_thanks" }
      },
      "exitPopup": {
        "title": "入力の途中ですが、よろしいですか？",
        "body": "LINEに登録すると、あとから続きを応募できます。",
        "cta": { "label": "LINEに登録して後で応募", "action": { "kind": "addFriend", "routeId": "route_exit_popup" } },
        "dismissLabel": "このまま閉じる"
      }
    },
    {
      "id": "page_thanks",
      "kind": "thanks",
      "title": "応募完了",
      "url": "https://example.com/apply/thanks",
      "blocks": [{ "kind": "heading", "text": "ご応募ありがとうございました" }, { "kind": "text", "text": "選考のご連絡を、LINEで受け取れます。メールより見落としにくく、日程の調整もかんたんです。" }],
      "lineCta": { "label": "LINEで選考の連絡を受け取る", "routeId": "route_thanks" }
    }
  ],
  "flows": [
    {
      "id": "flow_welcome",
      "label": "友だち追加 → 挨拶 → アンケート",
      "trigger": { "kind": "friendAdd" },
      "priority": 10,
      "concurrency": "exclusive",
      "reentry": "never",
      "nodes": [
        { "id": "n_w_entry", "type": "entry", "position": { "x": 0, "y": 0 } },
        {
          "id": "n_w_isapplied",
          "type": "branch",
          "label": "応募済み？",
          "position": { "x": 0, "y": 180 },
          "cases": [{ "id": "applied", "label": "応募済み", "when": { "op": "cv", "cvId": "cv_apply", "done": true } }]
        },
        { "id": "n_w_msg_applied", "type": "message", "messageId": "msg_welcome_applied", "position": { "x": -225, "y": 360 } },
        { "id": "n_w_msg", "type": "message", "messageId": "msg_welcome", "position": { "x": 225, "y": 360 } },
        { "id": "n_w_none", "type": "tag", "position": { "x": 0, "y": 540 }, "label": "未選択を付ける", "add": ["area_none"] },
        { "id": "n_w_survey", "type": "survey", "surveyId": "sv_hope", "timeoutMinutes": 1440, "position": { "x": 0, "y": 720 } },
        { "id": "n_w_end", "type": "end", "position": { "x": 0, "y": 900 }, "label": "エリア別の配信は、回答した時点で始まる" }
      ],
      "edges": [
        { "id": "e_w1", "from": { "nodeId": "n_w_entry", "port": "out" }, "to": "n_w_isapplied" },
        { "id": "e_w2", "from": { "nodeId": "n_w_isapplied", "port": "case:applied" }, "to": "n_w_msg_applied" },
        { "id": "e_w3", "from": { "nodeId": "n_w_isapplied", "port": "else" }, "to": "n_w_msg" },
        { "id": "e_w4", "from": { "nodeId": "n_w_msg_applied", "port": "out" }, "to": "n_w_none" },
        { "id": "e_w5", "from": { "nodeId": "n_w_msg", "port": "out" }, "to": "n_w_none" },
        { "id": "e_w_none", "from": { "nodeId": "n_w_none", "port": "out" }, "to": "n_w_survey" },
        { "id": "e_w6", "from": { "nodeId": "n_w_survey", "port": "done" }, "to": "n_w_end" },
        { "id": "e_w7", "from": { "nodeId": "n_w_survey", "port": "timeout" }, "to": "n_w_end" }
      ]
    },
    {
      "id": "flow_step_tokyo",
      "label": "東京希望のステップ配信",
      "trigger": { "kind": "manual" },
      "priority": 20,
      "concurrency": "exclusive",
      "reentry": "never",
      "stopWhen": { "op": "cv", "cvId": "cv_apply", "done": true },
      "nodes": [
        { "id": "n_t_entry", "type": "entry", "position": { "x": 0, "y": 0 } },
        { "id": "n_t_wait1", "type": "wait", "wait": { "kind": "dayAt", "day": 1, "time": "09:00", "from": "flowStart" }, "position": { "x": 0, "y": 150 } },
        { "id": "n_t_d1", "type": "message", "messageId": "msg_t_d1", "position": { "x": 0, "y": 300 } },
        { "id": "n_t_wait3", "type": "wait", "wait": { "kind": "dayAt", "day": 3, "time": "09:00", "from": "flowStart" }, "position": { "x": 0, "y": 450 } },
        {
          "id": "n_t_job",
          "type": "branch",
          "label": "希望職種",
          "position": { "x": 0, "y": 600 },
          "cases": [
            {
              "id": "office",
              "label": "事務",
              "when": { "op": "answer", "surveyId": "sv_hope", "questionId": "q_job", "match": "any", "choiceIds": ["c_office"] }
            }
          ]
        },
        { "id": "n_t_office", "type": "message", "messageId": "msg_t_office", "position": { "x": -200, "y": 750 } },
        { "id": "n_t_light", "type": "message", "messageId": "msg_t_light", "position": { "x": 200, "y": 750 } },
        { "id": "n_t_wait7", "type": "wait", "wait": { "kind": "dayAt", "day": 7, "time": "12:00", "from": "flowStart" }, "position": { "x": 0, "y": 900 } },
        { "id": "n_t_d7", "type": "choice", "messageId": "msg_t_d7", "timeoutMinutes": 4320, "position": { "x": 0, "y": 1050 } },
        { "id": "n_t_later", "type": "message", "messageId": "msg_t_later", "position": { "x": 200, "y": 1200 } },
        { "id": "n_t_end", "type": "end", "position": { "x": 0, "y": 1350 } }
      ],
      "edges": [
        { "id": "e_t1", "from": { "nodeId": "n_t_entry", "port": "out" }, "to": "n_t_wait1" },
        { "id": "e_t2", "from": { "nodeId": "n_t_wait1", "port": "out" }, "to": "n_t_d1" },
        { "id": "e_t3", "from": { "nodeId": "n_t_d1", "port": "out" }, "to": "n_t_wait3" },
        { "id": "e_t4", "from": { "nodeId": "n_t_wait3", "port": "out" }, "to": "n_t_job" },
        { "id": "e_t5", "from": { "nodeId": "n_t_job", "port": "case:office" }, "to": "n_t_office" },
        { "id": "e_t6", "from": { "nodeId": "n_t_job", "port": "else" }, "to": "n_t_light" },
        { "id": "e_t7", "from": { "nodeId": "n_t_office", "port": "out" }, "to": "n_t_wait7" },
        { "id": "e_t8", "from": { "nodeId": "n_t_light", "port": "out" }, "to": "n_t_wait7" },
