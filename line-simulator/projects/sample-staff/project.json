    { "id": "area_selected", "label": "希望エリア：回答済み", "group": "希望エリア", "description": "東京・大阪のどちらかを選ぶと付く。付いた時点で、地域別の求人配信に振り分ける" },
    { "id": "job_office", "label": "希望職種：事務", "group": "希望職種" },
