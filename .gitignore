# Office の一時ロックファイル
~$*

# Python
__pycache__/
*.pyc

# 認証情報（絶対にコミットしない）
service_account.json
credentials.json
token.json
config.txt
*.pem
*.key
.env

# 作業用の中間生成物
unpacked/
*_check/
slide-*.jpg
slide-*.png
thumbnails*.jpg

# 社内数字（売上・粗利・個人別数字を含むためコミットしない）
